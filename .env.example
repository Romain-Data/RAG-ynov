# ==== LLM (Mammouth) ====
MAMMOUTH_API_KEY=your_mammouth_api_key_here
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1   # adjust if needed
MAMMOUTH_CHAT_MODEL=mistral-medium-3-5         # actual Mammouth model ID

# ==== Vector Store (Qdrant) ====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=ynov_rag

# ==== Embedding (local FastEmbed) ====
# No API key needed; model is baked in the container.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAST_EMBED_CACHE_DIR=/app/.fastembed_cache

# ==== Ingest (CLI-only in V1) ====
INGEST_API_KEY=changeme
# Manifest doc_types skipped at ingestion (comma-separated, empty = ingest everything)
INGEST_EXCLUDE_DOC_TYPES=referentiel

# ==== Chat interface (Chainlit on /chat) ====
# Secret signing the session cookies; without it the chat is not mounted.
# Generate one with: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=
# SQLite file with the accounts and the conversations (docker-compose sets it to the volume)
CHAT_DB_PATH=chat_data/chat.db
# Copies of that database made by `python -m chat.backup` (docker-compose sets the folder), and how many to keep
CHAT_BACKUP_DIR=chat_backups
CHAT_BACKUP_KEEP=14

# ==== Site password (preprod only) ====
# HTTP Basic password (user "preprod") in front of the whole site, /api/health excepted.
# Leave empty in production. eval.e2e reads it from EVAL_SITE_PASSWORD.
SITE_PASSWORD=

# ==== CORS ====
# Comma-separated origins, or * for all (dev only).
# Example: CORS_ORIGINS=https://chat.example.com,https://admin.example.com
CORS_ORIGINS=*

# ==== Rate limiting (requests per minute per IP) ====
RATE_LIMIT_QUERY=30
RATE_LIMIT_INGEST=5
RATE_LIMIT_HEALTH=120
RATE_LIMIT_ACCOUNT=20

# =============================================================
# Coolify MCP (local dev tooling only)
# =============================================================
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_TOKEN=
